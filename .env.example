# Maily: optional, non-secret settings. Copy to .env (never committed) or export
# them in your shell. Secrets (OAuth client, tokens, IMAP passwords) never go
# here: they live encrypted in secrets.enc inside the data folder.

# Automatic sync interval while the app is open, in seconds (minimum 60).
MAILY_POLL_INTERVAL_SECONDS=180
# How many months of Gmail history the first sync downloads.
MAILY_BACKFILL_MONTHS=12
# Attachment cache size, in MB.
MAILY_ATTACHMENT_CACHE_MB=500
# Log level: DEBUG, INFO, WARNING, ERROR.
MAILY_LOG_LEVEL=INFO

# Use another data folder (demo, tests, separate profile). Same as --data-dir.
# MAILY_DATA_DIR=/path/to/a/folder
# Disable the Touch ID gate at launch (macOS, debugging only).
# MAILY_NO_BIOMETRIC=1
