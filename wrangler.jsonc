// Cloudflare Workers static assets for the product page (https://developers.cloudflare.com/workers/static-assets/).
// Deploy from the repository root: npx wrangler deploy
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maily-thanaelfontaine-eu",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "maily.thanaelfontaine.eu", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
